<Application x:Class="BlockStartLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101713"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#19241E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#55C76A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A6B5AA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#07110A"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26352B"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F5F1"/>
        </Style>
    </Application.Resources>
</Application>
