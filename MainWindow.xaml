<Window x:Class="BlockStartLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockStart Launcher" Height="650" Width="980"
        MinHeight="600" MinWidth="850" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="BLOCKSTART" FontSize="27" FontWeight="Black" Foreground="#65D879"/>
                <TextBlock Text="A simple launcher for your Minecraft worlds" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#26352B" CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                <TextBlock Text="WINDOWS 10 / 11" FontSize="11" FontWeight="Bold" Foreground="#B8EAC0"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="PLAY" FontSize="13" FontWeight="Bold" Foreground="#65D879"/>
                    <TextBlock Text="Choose your edition" FontSize="23" FontWeight="Bold" Margin="0,5,0,18"/>
                    <ComboBox x:Name="EditionBox" SelectionChanged="EditionBox_SelectionChanged">
                        <ComboBoxItem Content="Java Edition" IsSelected="True"/>
                        <ComboBoxItem Content="Bedrock Edition"/>
                    </ComboBox>
                    <TextBlock Text="Minecraft version" Margin="0,18,0,7" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="VersionBox"/>
                    <TextBlock Text="Java memory allocation" Margin="0,18,0,7" Foreground="{StaticResource MutedBrush}"/>
                    <DockPanel>
                        <TextBlock x:Name="RamValue" Text="4 GB" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#65D879"/>
                        <Slider x:Name="RamSlider" Minimum="2" Maximum="16" Value="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged"/>
                    </DockPanel>
                    <TextBlock Text="Only applies to Java Edition. Choose an amount your PC can spare." TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                    <Button x:Name="PlayButton" Content="▶   PLAY" FontSize="16" Margin="0,28,0,0" Height="52" Click="PlayButton_Click"/>
                    <Button Content="Refresh versions" Background="#314238" Foreground="White" Margin="0,10,0,0" Click="RefreshButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="ACCOUNT" FontSize="13" FontWeight="Bold" Foreground="#65D879"/>
                    <TextBlock Text="Java sign-in" FontSize="23" FontWeight="Bold" Margin="0,5,0,8"/>
                    <TextBlock Text="Sign in with the Microsoft account that owns Minecraft: Java Edition. Authentication is handled by the CmlLib library." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="19"/>
                    <Button x:Name="LoginButton" Content="Sign in with Microsoft" Margin="0,18,0,0" Click="LoginButton_Click"/>
                    <TextBlock x:Name="AccountLabel" Text="Not signed in" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                    <Separator Margin="0,25,0,20" Background="#34463A"/>
                    <TextBlock Text="BEDROCK EDITION" FontSize="13" FontWeight="Bold" Foreground="#65D879"/>
                    <TextBlock Text="Use official installation" FontSize="18" FontWeight="Bold" Margin="0,5,0,8"/>
                    <TextBlock Text="Bedrock is installed and updated through Microsoft Store / Xbox app. This launcher opens the official Store listing if the game cannot be opened directly." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="19"/>
                    <TextBlock Text="Bedrock does not expose Java-style version or RAM controls." TextWrapping="Wrap" Foreground="#E6C987" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#19241E" CornerRadius="10" Padding="14" Margin="0,18,0,0">
            <DockPanel>
                <TextBlock Text="STATUS" Foreground="#65D879" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Text="Ready. Select an edition to begin." Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
